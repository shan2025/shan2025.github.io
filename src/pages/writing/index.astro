---
import Base from '../../layouts/Base.astro';
import Bar from '../../components/Bar.astro';
import { getCollection } from 'astro:content';
import { site } from '../../data/site';
import '../../styles/inner.css';

// This page is rendered on request (not at build) so new Substack posts show up on their own:
// it reads Shadin's Substack RSS feed and lists any post that isn't already written up here.
export const prerender = false;

// posts written up on this site (the rich, on-site versions)
const local = (await getCollection('writing', ({ data }) => !data.draft)).map((p) => ({
  title: p.data.title,
  excerpt: p.data.excerpt,
  date: p.data.date,
  href: `/writing/${p.id}/`,
  external: false,
  cover: p.data.cover,
  coverAlt: p.data.coverAlt,
}));

// a tiny RSS reader: pull <item>s from the feed, strip CDATA and tags
const key = (t: string) => t.toLowerCase().replace(/[^a-z0-9]/g, '');
const pick = (block: string, tag: string) => {
  const m = block.match(new RegExp(`<${tag}[^>]*>([\\s\\S]*?)</${tag}>`, 'i'));
  if (!m) return '';
  return m[1].replace(/<!\[CDATA\[([\s\S]*?)\]\]>/g, '$1').replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
};
const fromFeed = async () => {
  if (!site.substackFeed) return [];
  const ctrl = new AbortController();
  const t = setTimeout(() => ctrl.abort(), 2500);
  try {
    const res = await fetch(site.substackFeed, { signal: ctrl.signal, headers: { 'user-agent': 'shadin.xyz' } });
    if (!res.ok) return [];
    const xml = await res.text();
    const items = xml.split(/<item>/).slice(1).map((chunk) => chunk.split('</item>')[0]);
    return items.map((it) => {
      const title = pick(it, 'title');
      const raw = pick(it, 'description');
      return {
        title,
        excerpt: raw.length > 180 ? `${raw.slice(0, 177)}…` : raw,
        date: new Date(pick(it, 'pubDate') || Date.now()),
        href: pick(it, 'link'),
        external: true,
        // Substack puts the post's picture in an <enclosure> tag
        cover: it.match(/<enclosure[^>]*\burl="([^"]+)"/i)?.[1],
        coverAlt: '',
      };
    }).filter((p) => p.title && p.href);
  } catch {
    return []; // feed slow or unreachable: just show the on-site posts
  } finally {
    clearTimeout(t);
  }
};

// merge: keep every on-site post, add Substack posts that aren't already written up here
const localKeys = new Set(local.map((p) => key(p.title)));
const feed = (await fromFeed()).filter((p) => !localKeys.has(key(p.title)));
const posts = [...local, ...feed].sort((a, b) => b.date.valueOf() - a.date.valueOf());

// let the edge cache the page, so it's fast and still refreshes within the half hour
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=1800, stale-while-revalidate=86400');

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Writing" description="Notes from building FinChat and from growth and product work at Hancod, plus essays from Shadin's Substack.">
  <Bar slot="header" current="writing" />
  <div class="page">
    <div class="page__head">
      <h1 class="page__title">Writing</h1>
      <p class="page__intro">
        Notes from building in public, and essays on the things we make.
        {site.links.substack && <> Also on <a class="link" href={site.links.substack}>Substack</a>.</>}
      </p>
    </div>
    <ul class="index">
      {posts.map((p) => (
        <li>
          <a class:list={['index__row', { 'index__row--cover': p.cover }]} href={p.href} {...(p.external ? { target: '_blank', rel: 'noopener' } : {})}>
            <span class="index__lead">
              {p.cover && <img class="index__thumb" src={p.cover} alt={p.coverAlt} width="1024" height="1024" loading="lazy" decoding="async" />}
              <span class="index__title">{p.title}{p.external && <span class="index__ext">Substack ↗</span>}</span>
            </span>
            <span class="index__excerpt">{p.excerpt}</span>
            <time class="index__date" datetime={p.date.toISOString()}>{fmt(p.date)}</time>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
