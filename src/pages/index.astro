---
import Base from '../layouts/Base.astro';
import Bar from '../components/Bar.astro';
import WorkFigure from '../components/WorkFigure.astro';
import { getCollection } from 'astro:content';
import { site, resumes, interests } from '../data/site';
import { certifications } from '../data/certifications';
import '../styles/home.css';

const work = (await getCollection('work', ({ data }) => !data.placeholder)).sort((a, b) => a.data.order - b.data.order);
const products = (await getCollection('products', ({ data }) => !data.placeholder)).sort((a, b) => a.data.order - b.data.order);
const writing = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const suggestions = ['What has Shadin built?', 'Tell me about FinChat', 'Is he open to new roles?', 'What did he do at Hancod?'];

// ---- The map of ideas: every node is something real on this site, every link a real connection ----
type Node = { id: string; label: string; kind: 'core' | 'hub' | 'leaf'; text: string; href: string };
const nodes: Node[] = [
  { id: 'me', label: 'Shadin', kind: 'core', text: 'Product and growth at Hancod, and the builder of FinChat.', href: '/resume/' },
  { id: 'work', label: 'Projects', kind: 'hub', text: 'Three projects, each with what ran and what actually worked.', href: '#explore' },
  { id: 'writing', label: 'Writing', kind: 'hub', text: 'Notes from building in public.', href: '/writing/' },
  { id: 'products', label: 'Products', kind: 'hub', text: 'Things you can use or buy.', href: '#explore' },
  { id: 'interests', label: 'Interests', kind: 'hub', text: 'The fields Shadin follows most closely.', href: '#explore' },
  { id: 'resume', label: 'Résumé', kind: 'leaf', text: 'Three versions, for product, AI and analyst roles.', href: '/resume/' },
  ...work.map((w) => ({ id: w.id, label: w.data.name, kind: 'leaf' as const, text: w.data.kind, href: `/work/${w.id}/` })),
  ...writing.map((p) => ({ id: `post-${p.id}`, label: p.data.title, kind: 'leaf' as const, text: p.data.excerpt, href: `/writing/${p.id}/` })),
  ...interests.map((i) => ({ id: i.id, label: i.name, kind: 'leaf' as const, text: i.note, href: '#explore' })),
];
const links: [string, string, number?][] = [
  ['me', 'work'], ['me', 'writing'], ['me', 'products'], ['me', 'interests'], ['me', 'resume'],
  ...work.map((w) => ['work', w.id] as [string, string]),
  ...writing.map((p) => ['writing', `post-${p.id}`] as [string, string]),
  ['products', 'finchat'],
  ...interests.map((i) => ['interests', i.id] as [string, string]),
  ['finchat', 'agents', 0.3], ['finchat', 'evals', 0.3], ['finchat', 'fintech', 0.3],
  ['wallet-risk', 'fintech', 0.3], ['wallet-risk', 'evals', 0.3],
  ['hancod', 'growth', 0.3], ['hancod', 'product', 0.3],
  ['spacex-landing', 'evals', 0.3], ['spacex-landing', 'wallet-risk', 0.3],
  ['mock-interview', 'product', 0.3],
  ['post-from-blockchain-to-ai-agents', 'finchat', 0.3], ['post-agents-that-report-back', 'finchat', 0.3],
  ['post-ran-is-not-worked', 'evals', 0.3], ['post-ran-is-not-worked', 'hancod', 0.3],
];
const mapData = JSON.stringify({ nodes, links: links.filter(([a, b]) => nodes.some((n) => n.id === a) && nodes.some((n) => n.id === b)) });

// ---- The board: six kinds of chess piece, one for each side of the work ----
const certLink = (name: string) => certifications.find((c) => c.name.startsWith(name))?.url;
const skill = (title: string, text: string) => ({ type: 'skill', kind: 'Skill', title, text, href: '/resume/' });
const cert = (title: string, short: string) => {
  const c = certifications.find((x) => x.name.startsWith(title))!;
  return { type: 'cert', kind: `Certificate, ${c.issuer}`, title: short, text: c.about, href: certLink(title) };
};
const proj = (id: string) => {
  const w = work.find((x) => x.id === id)!;
  return { type: 'project', kind: `Project, ${w.data.kind}`, title: w.data.name, text: w.data.worked, href: `/work/${id}/` };
};
const edu = (title: string, text: string) => ({ type: 'edu', kind: 'Education', title, text, href: '/resume/' });
const act = (title: string, text: string) => ({ type: 'edu', kind: 'Leadership', title, text, href: '/resume/' });
const interest = (id: string) => {
  const i = interests.find((x) => x.id === id)!;
  return { type: 'interest', kind: 'Interest', title: i.name, text: i.note, href: '#explore' };
};
const post = (id: string, label: string) => {
  const p = writing.find((x) => x.id === id)!;
  return { type: 'note', kind: 'Writing', title: p.data.title, label, text: p.data.excerpt, href: `/writing/${p.id}/` };
};
type Square = { title: string; label?: string; kind: string; text: string; href?: string };
// piece is the letter board-scene.js sets up (r rook, q queen, b bishop, p pawn, n knight, k king); glyph is its white symbol.
const boardSides: { piece: string; glyph: string; pieceName: string; name: string; text: string; items: Square[] }[] = [
  { piece: 'r', glyph: '♖', pieceName: 'The rooks', name: 'Projects', text: 'Things I built and shipped, and what actually happened.',
    items: [proj('finchat'), proj('hancod'), { ...proj('wallet-risk'), label: 'Wallet risk' }, { ...proj('spacex-landing'), label: 'Falcon 9' }, { ...proj('mock-interview'), label: 'Mock interviews' }] },
  { piece: 'q', glyph: '♕', pieceName: 'The queen', name: 'AI', text: 'Agents, retrieval and evaluation: what I build with and keep learning.',
    items: [{ ...cert('RAG for Generative', 'RAG Specialization'), label: 'RAG' }, { ...cert('Introduction to Model Context', 'Intro to MCP'), label: 'MCP' }, cert('AI Fluency', 'AI Fluency'), interest('agents'), interest('evals'), post('agents-that-report-back', 'Agents report back')] },
  { piece: 'b', glyph: '♗', pieceName: 'The bishops', name: 'Product', text: 'Specs, testing and the habit of checking the outcome, not the status.',
    items: [{ ...skill('Specs & requirements', 'BRDs, FRDs, FSDs and HFDs for 12+ modules at Hancod, with user stories and acceptance criteria written before design starts.'), label: 'Requirements' }, { ...skill('UAT & defects', 'End-to-end testing at Hancod, from test scenarios to defect closure, across design, engineering and QA.'), label: 'UAT' }, interest('product'), post('ran-is-not-worked', 'Status vs outcome'), { kind: 'Résumé', title: 'Résumé', text: 'Three one-page versions: product, AI and business analysis, and business analysis.', href: '/resume/' }] },
  { piece: 'p', glyph: '♙', pieceName: 'The pawns', name: 'Data', text: 'Python, SQL and machine learning, from the IBM programme to my own studies.',
    items: [skill('Python & ML', 'Pandas, scikit-learn and machine learning, from the IBM Data Science programme to the wallet and Falcon 9 studies.'), { ...skill('SQL & Power BI', 'Funnels, metrics and dashboards in SQL, Power BI and Tableau.'), label: 'SQL & BI' }, { ...cert('IBM Data Science', 'IBM Data Science'), label: 'IBM DS' }, { ...cert('Applied Data Science', 'Applied Data Science'), label: 'Applied DS' }] },
  { piece: 'n', glyph: '♘', pieceName: 'The knights', name: 'Growth', text: 'Acquisition and conversion at Hancod, an MBA in FinTech, and the roles I took on at university.',
    items: [skill('Growth', 'Owning user acquisition and conversion for a live service website as Growth Manager Trainee at Hancod.'), { ...edu('MBA, FinTech', 'MBA in Financial Technology, Pondicherry University (Central University), 2024 to 2026.'), label: 'MBA' }, interest('fintech'), { ...act('TEDx Pondicherry', 'Speaker liaison at TEDx Pondicherry University 2025 for G. Karthikeyan, founder of Sristi: coordinating the speaker, the team and university admin.'), label: 'TEDx' }, { ...act('BANQUEST 2024', 'Student coordinator for BANQUEST 2024, the department’s flagship industry–academia programme.'), label: 'BANQUEST' }, post('from-blockchain-to-ai-agents', 'Blockchain to AI')] },
  { piece: 'k', glyph: '♔', pieceName: 'The king', name: 'Me', text: 'Where I studied, where to read me, and how to reach me.',
    items: [edu('BCA', 'Bachelor of Computer Applications, Punjab Technical University, Chandigarh Group of Colleges, 2020 to 2023.'), { kind: 'Contact', title: 'Say hello', text: `Hiring, a project, or a question about FinChat? Write to ${site.email}.`, href: `mailto:${site.email}` }, { kind: 'Writing', title: 'Writing', text: 'Notes from building in public.', href: '/writing/' }, { kind: 'Profile', title: 'GitHub', text: 'Code for FinChat, the wallet risk study, the Falcon 9 capstone and more.', href: site.links.github }, { kind: 'Profile', title: 'LinkedIn', text: 'Where I post about what I’m building.', href: site.links.linkedin }] },
];

const tabs = [
  { id: 'projects', label: 'Projects' },
  { id: 'writing', label: 'Writing' },
  { id: 'products', label: 'Products' },
  { id: 'map', label: 'Mind map' },
  { id: 'certs', label: 'Certifications' },
  { id: 'resume', label: 'Résumé' },
];
---
<Base>
  <div class="hero">
    <div class="glow" aria-hidden="true"></div>
    <!-- The mind: the brain forms on the first screen, then stays behind "Ask anything" as you scroll -->
    <div class="mind">
    <canvas class="brain" id="brain" aria-hidden="true"></canvas>
    <Bar />
    <section class="opening" aria-label="Introduction">
      <p class="opening__title">Ideas, connected.</p>
      <p class="opening__sub">Each point is something I’ve built, studied or care about. Watch it wire itself up, then scroll down and ask it anything.</p>
      <a class="opening__cue" href="#ask">
        Ask me
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v9M4.5 8.5 8 12l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </section>
    <section class="ask" id="ask" aria-labelledby="ask-title">
      <a class="badge" href="/resume/" data-load style="--d:0ms">
        <span class="badge__dots" aria-hidden="true"><span></span><span></span><span></span></span>
        Open to product, BA and PM roles
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <h1 id="ask-title" class="ask__title" data-load style="--d:80ms">Ask anything about Shadin</h1>

      <div class="chat" id="chat" aria-live="polite" aria-label="Conversation" hidden></div>

      <form class="box" id="ask-form" data-load style="--d:160ms">
        <label class="sr-only" for="ask-input">Your question about Shadin</label>
        <textarea id="ask-input" name="q" rows="1" maxlength="1000" placeholder="Ask about his work, FinChat, or the roles he wants…" autocomplete="off"></textarea>
        <div class="box__row">
          <button type="button" class="box__icon" id="ask-new" title="New chat" aria-label="Start a new chat">
            <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
          </button>
          <span class="box__hint">AI assistant</span>
          <button type="button" class="box__icon" id="ask-mic" title="Speak your question" aria-label="Speak your question" hidden>
            <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><rect x="7" y="2.5" width="6" height="10" rx="3" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4.5 9.5a5.5 5.5 0 0 0 11 0M10 15v2.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </button>
          <button type="submit" class="box__send" id="ask-send" aria-label="Send">
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M9 14V4M4.5 8.5 9 4l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </form>

      <ul class="chips" id="ask-chips" data-load style="--d:240ms">
        {suggestions.map((s) => <li><button type="button" class="chip">{s}</button></li>)}
      </ul>
      <p class="ask__note" data-load style="--d:300ms">Answers come from Shadin’s own work and résumé, and can be wrong. For anything important, <a class="link" href={`mailto:${site.email}`}>email him</a>.</p>
    </section>
    </div>

    <!-- The board: six sides of the work as six kinds of chess piece, sitting on the page (three.js, see board-scene.js).
         Its canvas reaches a little past the stage, so the pieces have room to lift. -->
    <section class="board" id="board" aria-labelledby="board-heading">
      <div class="board__head">
        <p class="board__tag">// 03 &nbsp;The board</p>
        <h2 id="board-heading" class="board__heading">Every side of my work</h2>
        <p class="board__intro">Six kinds of piece, six sides of my work. Tap a piece to read about it, turn the board any way you like, or just make a move: my AI plays like me.</p>
      </div>
      <div class="board__body">
        <div class="board__stage" aria-label="A chess board of Shadin’s work. Drag to turn it, tap a piece to read it, or move a piece from your side to play his AI.">
          <canvas class="board__canvas" aria-hidden="true"></canvas>
          <p class="board__tip" aria-hidden="true" hidden></p>
        </div>
        <aside class="board__card" aria-live="polite">
          <p class="board__kind">How it works</p>
          <h3 class="board__title">Make a move</h3>
          <p class="board__text">Each kind of piece is one side of my work: the rooks are my projects, the queen is AI, the king is me. Tap one to read it. To play my AI, move a piece from your side: white, or turn the board round to play black.</p>
          <ul class="board__items" hidden></ul>
          <a class="button board__link" href="#board" hidden>Open</a>
          <div class="board__sides" role="group" aria-label="Sides of my work">
            {boardSides.map((s) => <button type="button" class="board__side" data-piece={s.piece} aria-pressed="false"><span class="board__glyph" aria-hidden="true">{s.glyph}</span>{s.name}</button>)}
          </div>
          <p class="board__controls">
            <button type="button" class="board__btn board__btn--go" data-act="why" hidden>Why?</button>
            <button type="button" class="board__btn" data-act="again" hidden>Play again</button>
            <button type="button" class="board__btn" data-act="resign" hidden>Resign</button>
          </p>
        </aside>
      </div>
      <ul class="board__list">
        {boardSides.map((s) => <li><strong>{s.glyph} {s.name}:</strong> {s.items.map((it, i) => <>{i > 0 && ', '}{it.href ? <a href={it.href}>{it.title}</a> : it.title}</>)}</li>)}
      </ul>
      <script type="application/json" id="board-data" set:html={JSON.stringify(boardSides)} />
    </section>

    <!-- The rest of the site, in a panel rising from the bottom of the glow -->
    <section class="panel" id="explore" aria-label="Explore Shadin’s work">
      <div class="panel__head">
        <div class="tabs" role="tablist" aria-label="Sections">
          {tabs.map((t, i) => (
            <button type="button" role="tab" class="tab" id={`tab-${t.id}`} aria-controls={`pane-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.label}</button>
          ))}
        </div>
        <a class="panel__all" href="/writing/">All writing
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

      <div class="pane" role="tabpanel" id="pane-projects" aria-labelledby="tab-projects">
        <ul class="cards">
          {work.map((w) => (
            <li>
              <a class="card" href={`/work/${w.id}/`}>
                <div class="card__shot"><WorkFigure id={w.id} /></div>
                <h2 class="card__title">{w.data.name}</h2>
                <p class="card__meta">{w.data.kind}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="pane" role="tabpanel" id="pane-writing" aria-labelledby="tab-writing">
        <ul class="cards">
          {writing.map((p) => (
            <li>
              <a class="card card--text" href={`/writing/${p.id}/`}>
                <h2 class="card__title">{p.data.title}</h2>
                <p class="card__excerpt">{p.data.excerpt}</p>
                <p class="card__meta"><time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time></p>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="pane" role="tabpanel" id="pane-products" aria-labelledby="tab-products">
        <div class="product">
          <div class="product__shot"><WorkFigure id="roster" /></div>
          {products.map((p) => (
            <div class="product__text">
              <h2 class="product__name">{p.data.name}</h2>
              <p>{p.data.summary}</p>
              <p class="product__price">{p.data.price}</p>
              <a class="button" href={p.data.buyUrl}>{p.data.buyLabel}</a>
            </div>
          ))}
        </div>
      </div>

      <div class="pane" role="tabpanel" id="pane-map" aria-labelledby="tab-map">
        <div class="mapwrap">
          <figure class="map" aria-labelledby="map-label" data-ui>
            <figcaption class="sr-only" id="map-label">An interactive map of Shadin’s projects, writing, products and interests, and how they connect.</figcaption>
            <svg class="map__svg" id="map" role="group" aria-label="Map of ideas"></svg>
            <ul class="map__fallback">{nodes.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
          </figure>
          <aside class="map-card" aria-live="polite">
            <h2 class="map-card__title" id="map-title">A map of his work</h2>
            <p class="map-card__text" id="map-text">Click a point to read about it. Drag one point onto another to connect two ideas.</p>
            <p class="map-card__foot"><a class="link" id="map-link" href="#explore" hidden>Open</a><span id="map-count"></span><button type="button" class="map-card__reset" id="map-reset" hidden>Clear my connections</button></p>
          </aside>
        </div>
        <script type="application/json" id="map-data" set:html={mapData} />
      </div>

      <div class="pane" role="tabpanel" id="pane-certs" aria-labelledby="tab-certs">
        <ul class="cards">
          {certifications.map((c) => (
            <li>
              <article class="card card--text card--cert">
                <p class="cert__issuer"><span class="cert__badge" aria-hidden="true">{c.issuer.slice(0, 1)}</span>{c.issuer}{c.platform !== c.issuer && `, on ${c.platform}`}{(c.date ?? c.year) && `, ${c.date ?? c.year}`}</p>
                <h2 class="card__title">{c.name}</h2>
                <p class="card__excerpt">{c.about}</p>
                {c.courses && (
                  <details class="cert__courses">
                    <summary>{c.courses.length} courses completed</summary>
                    <ul>{c.courses.map((k) => <li><a class="link" href={k.url}>{k.name}</a></li>)}</ul>
                  </details>
                )}
                {c.url && <p class="card__meta"><a class="link" href={c.url}>Verify certificate</a></p>}
              </article>
            </li>
          ))}
        </ul>
      </div>

      <div class="pane" role="tabpanel" id="pane-resume" aria-labelledby="tab-resume">
        <ul class="cards">
          {resumes.map((r) => (
            <li>
              <a class="card card--text" href={r.href} download>
                <h2 class="card__title">{r.label} résumé</h2>
                <p class="card__excerpt">{r.note}. One page, PDF.</p>
                <p class="card__meta">Download</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>

  <script src="../scripts/brain.js"></script>
  <script src="../scripts/board.js"></script>
  <script src="../scripts/tabs.js"></script>
  <script src="../scripts/chat.js"></script>
  <script src="../scripts/mindmap.js"></script>
</Base>
