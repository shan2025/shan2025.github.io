# Copy this file to .env for local testing, and add AI_API_KEY in Vercel → Settings → Environment Variables.
# Your DeepSeek key, from https://platform.deepseek.com/api_keys
AI_API_KEY=

# Optional. DeepSeek is the default; set these only to use another OpenAI-compatible provider.
# Example for Groq's free tier:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODELS=openai/gpt-oss-20b,llama-3.1-8b-instant
